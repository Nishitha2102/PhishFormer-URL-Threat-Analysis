# Backend API URL
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/phishformer?retryWrites=true&w=majority&ssl=true

# Database name
DB_NAME=phishformer

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string-min-32-chars
